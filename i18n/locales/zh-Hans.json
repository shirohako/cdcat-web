  "about_page": {
    "label": "关于 CDCAT", "intro": "CDCAT 是一个面向重度听歌用户的音乐资料站点。", "highlights": {
      "archive_title": "音乐档案馆", "archive_desc": "CDCAT 希望保存每一份存在过的音乐资料，尤其是容易随着社团解散和官网关闭而消失的独立及同人音乐。", "timeline_title": "时间胶囊", "timeline_desc": "记录听过和喜欢的歌曲，建立不会因版权下架而消失的个人音乐轨迹，并分享喜爱的歌曲与艺术家。", "creator_title": "创作者友好", "creator_desc": "整理普通版、限定版、受注版、高解析度版和下载版，以及不同店铺特典与官方售卖链接，让听众更容易理解并支持作品。", "developer_title": "开发者友好", "developer_desc": "CDCAT 将提供公开 API 和文档，欢迎基于社区维护的数据开发歌词、封面匹配和其他应用。", "relations_title": "完善的关联", "relations_desc": "将音乐与游戏、动画、电影、电视剧、条目和系列关联起来，方便从不同视角探索。", "community_title": "综合音乐社区", "community_desc": "除音乐资料外，CDCAT 也希望承载音频设备、实体收藏、数字发行、制作技术和创作分享等交流。", "stories_title": "深入了解音乐", "stories_desc": "后续将关联创作者访谈、Booklet 资料和用户贡献歌词，帮助听众了解音乐背后的故事。"
